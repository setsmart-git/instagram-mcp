{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.setsmart-git/instagram-mcp",
  "description": "Instagram, WhatsApp and Messenger DMs through official Meta Business APIs.",
  "repository": {
    "url": "https://github.com/setsmart-git/instagram-mcp",
    "source": "github"
  },
  "version": "0.1.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "setsmart-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SETSMART_API_KEY",
          "description": "Your SetSmart workspace API key, from Settings then Integrations",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "title": "SetSmart",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://setsmart.io/api/mcp"
    }
  ],
  "websiteUrl": "https://setsmart.io"
}
